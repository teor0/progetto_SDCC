# stage 1
FROM golang:1.26-alpine3.24 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

# Copy only what the user service actually needs to build.
COPY gen/upload   ./gen/upload
COPY gen/user      ./gen/user
COPY internal/auth  ./internal/auth
COPY gen/gallery   ./gen/gallery
COPY internal/gallery  ./internal/gallery
COPY internal/upload  ./internal/upload
COPY cmd/upload       ./cmd/upload

# build user-service
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /upload-service ./cmd/upload

# stage 2
FROM alpine:3.24

RUN apk add --no-cache ca-certificates && \
    addgroup -S app && adduser -S app -G app

WORKDIR /

COPY --from=builder --chown=app:app /upload-service /upload-service

USER app

# gRPC server + gRPC-Gateway HTTP proxy, per main.go
EXPOSE 8093

# container name alias
ENTRYPOINT ["/upload-service"]