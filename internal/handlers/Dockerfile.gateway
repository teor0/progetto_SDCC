# stage 1
FROM golang:1.26-alpine3.24 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

# Copy only what the gateway actually needs to build.
COPY gen/upload         ./gen/upload
COPY gen/notification   ./gen/notification
COPY gen/gallery        ./gen/gallery
COPY gen/user           ./gen/user
COPY internal/clients   ./internal/clients
COPY internal/handlers  ./internal/handlers
COPY cmd/gateway        ./cmd/gateway

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /gateway ./cmd/gateway

# stage 2
FROM alpine:3.24

RUN apk add --no-cache ca-certificates && \
    addgroup -S app && adduser -S app -G app

WORKDIR /

COPY --from=builder --chown=app:app /gateway /gateway

USER app

EXPOSE 8080

ENTRYPOINT ["/gateway"]