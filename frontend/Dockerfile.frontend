# stage 1: build the SPA
FROM node:22-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Left empty on purpose: nginx reverse-proxies /photogallery and
# /api to the gateway container on the SAME origin the frontend is served
# from, so the browser never needs an absolute gateway URL baked in at
# build time. See frontend/src/services/api.ts:
#   const API_BASE_URL = import.meta.env.VITE_API_BASE_URL ?? "http://localhost:8080"
# An empty string here means every request is issued as a relative path
# (e.g. "/photogallery/auth/login"), which nginx then proxies internally.
# This is what makes the image portable across any EC2 public IP/DNS
# without a rebuild.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

ENTRYPOINT ["nginx", "-g", "daemon off;"]