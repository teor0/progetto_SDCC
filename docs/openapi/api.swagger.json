            "$ref": "#/definitions/protoMember"
          }
        }
      }
    },
    "protoLoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "protoMember": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "galleryId": {
          "type": "string"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "protoRegisterRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
