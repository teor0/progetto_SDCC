        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/protoCreateGalleryRequest"
            }
          }
        ],
        "tags": [
          "GalleryService"
        ]
      }
    },
    "/photogallery/galleries/{galleryId}": {
      "get": {
        "summary": "GetGallery returns the details of a single gallery.",
