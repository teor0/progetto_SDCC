          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "protoGalleryStatus": {
      "type": "string",
      "enum": [
        "GALLERY_STATUS_UNSPECIFIED",
        "GALLERY_STATUS_OPEN",
        "GALLERY_STATUS_CLOSED"
      ],
      "default": "GALLERY_STATUS_UNSPECIFIED"
