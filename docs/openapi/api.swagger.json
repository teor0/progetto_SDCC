        "tags": [
          "GalleryService"
        ]
      },
      "post": {
        "summary": "CreateGallery creates a new gallery. Caller must be MODERATOR.",
        "operationId": "GalleryService_CreateGallery",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/protoGallery"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
