    "/photogallery/galleries": {
      "get": {
        "summary": "ListGalleries returns all open galleries, optionally filtered to the caller's memberships.",
        "operationId": "GalleryService_ListGalleries",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/protoListGalleriesResponse"
