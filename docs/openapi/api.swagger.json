    "protoRole": {
      "type": "string",
      "enum": [
        "ROLE_UNSPECIFIED",
        "ROLE_USER",
        "ROLE_MODERATOR"
      ],
      "default": "ROLE_UNSPECIFIED"
    },
    "protoSendModeratorAlertResponse": {
      "type": "object"
    },
    "protoTokenResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "expiresIn": {
